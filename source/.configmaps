[
	{
		#formatVersion : '1.1',
		#name : 'MCP SDK',
		#versionName : '1.0.0',
		#ts : 3968074339,
		#applications : [
			{
				#name : 'JsonCanonicalizationApp'
			},
			{
				#name : 'McpApp'
			},
			{
